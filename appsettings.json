{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PocketSpace": {
    "DirectorySettings": {
      "TargetDirectory": "D:\\MyStorage"
    }
  },
  "Kestrel": {
    "Limits": {
      "KeepAliveTimeout": "01:00:00",
      "RequestHeadersTimeout": "01:00:00"
    }
  }

}
